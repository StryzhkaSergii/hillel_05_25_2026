CREATE TABLE public.classes (
	id int2 GENERATED ALWAYS AS IDENTITY NOT NULL,
	"name" varchar NOT NULL,
	description varchar NULL,
	CONSTRAINT classes_pk PRIMARY KEY (id),
	CONSTRAINT classes_unique UNIQUE ("name")
);


