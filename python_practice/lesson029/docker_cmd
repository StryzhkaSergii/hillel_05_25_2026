docker build . -f base.Dockerfile -t base_image - зробити білд image на основі файлу base.Dockerfile
docker images - переглянути доступні image
docker rmi <imageTag> - видалення image
docker run <image_name> - запустити контейнер на базі певного image
docker ps -a - подивитися список контейнерів запущених і закритих
docker compose build - збілдити все що є в docker-compose.yaml
docker compose up
docker run -v ./docker_results:/app/results base_image - запустити контейнер з shared volumes